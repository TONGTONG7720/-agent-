# 复制为 .env 并填入真实 Key（.env 已被 .gitignore 排除，绝不入库）
# 用不到的模型留空即可（不要删除变量名，litellm 启动时会解析）

# 网关自身的访问密钥（agent 服务的 AGENT_LLM_API_KEY 填同一个值）
LITELLM_MASTER_KEY=sk-magent-local

# 通义千问（阿里云百炼）https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# DeepSeek 官方 https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 智谱 https://open.bigmodel.cn/
ZHIPU_API_KEY=

# 第三方运营商中转（OpenAI 兼容）
RELAY_BASE_URL=https://example.com/v1
RELAY_API_KEY=
