# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，绝不入库）
# 生成随机值示例（PowerShell）：
#   python -c "import secrets;print('magent_'+secrets.token_urlsafe(32))"
#   python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(16)))"

# 与 Agent 服务共享的内网令牌（必须与 agent/.env 的 AGENT_INTERNAL_TOKEN 一致）
INTERNAL_TOKEN=

# 数据库模型 Key 的 AES 加密密钥（必须 16 字节）
AES_KEY=

# 本地 MySQL 连接
DB_USER=root
DB_PASSWORD=
